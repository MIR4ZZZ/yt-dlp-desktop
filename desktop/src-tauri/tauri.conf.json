{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unofficial yt-dlp Desktop",
  "version": "1.3.0-preview.1",
  "identifier": "com.mir4zzz.ytdlpdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Unofficial yt-dlp Desktop",
        "width": 1040,
        "height": 700,
        "minWidth": 640,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
